# =============================================================================
# WebPulse — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# =============================================================================

# --- LLM API Configuration ---
# Supported providers: "openai" or "anthropic"
# Set the provider and the corresponding API key.

LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# OpenAI API key (required if LLM_PROVIDER=openai)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (required if LLM_PROVIDER=anthropic)
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# LLM model name (optional, defaults shown)
# For OpenAI:   gpt-4o, gpt-4o-mini, gpt-3.5-turbo, etc.
# For Anthropic: claude-sonnet-4-20250514, claude-3-haiku-20240307, etc.
LLM_MODEL=gpt-4o-mini

# --- ASR / Speech-to-Text Configuration ---
# WebPulse uses OpenAI Whisper (local) by default — no API key needed.
# If you want to use a cloud-based ASR instead, configure below.

# ASR_PROVIDER=whisper_local
# ASR_API_KEY=your-asr-api-key-here

# --- TTS Configuration (optional) ---
# Default: pyttsx3 (local, no API key needed).
# For cloud TTS (e.g., ElevenLabs), set the provider and key.

# TTS_PROVIDER=pyttsx3
# TTS_API_KEY=your-tts-api-key-here

# --- General ---
# Session data output directory (default: ./sessions/)
# SESSION_DIR=./sessions/
